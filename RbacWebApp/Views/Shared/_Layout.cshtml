@using RbacWebApp.Services
@inject MenuService MenuService
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
</head>
<body>
    <nav>
        <ul>
        @{
            var menu = await MenuService.GetMenuForUserAsync(User.Identity?.Name ?? string.Empty);
            foreach (var item in menu)
            {
                <li><a href="@item.Url">@item.Title</a></li>
            }
        }
        </ul>
    </nav>
    <main>
        @RenderBody()
    </main>
</body>
</html>
